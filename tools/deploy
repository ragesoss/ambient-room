#!/bin/sh
# Copy this tree to the Pi and run its installer.
#   tools/deploy [HOST]     HOST: an ssh host (default: practice)
set -eu
host=${1:-practice}
here=$(cd "$(dirname "$0")/.." && pwd)
rsync -a --delete \
    --exclude .venv --exclude __pycache__ --exclude .pytest_cache \
    --exclude .git --exclude 'state-*.json' --exclude /renders --exclude /local \
    "$here/" "$host:ambient-room/"
ssh "$host" ambient-room/setup/install.sh
