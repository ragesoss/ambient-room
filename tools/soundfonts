#!/usr/bin/env python3
"""Build the sampled voices' SoundFonts into sounds/.

  tools/soundfonts [FLUID_SF2] [DOBRO_SF2]

- sounds/acoustic.sf2: only the presets the voices use, copied out of
  FluidR3_GM (MIT licence; Debian's fluid-soundfont-gm), so the Pi loads a
  few MB instead of 141.
- sounds/dobro.sf2: the player's own dobro prototype, as it is (from
  ~/play/dobro-transcription/dobro-soundfont; not for publication).

Both are then normalised (normalise()) so the Pi's Csound reads them right:
Debian's Csound 6.18.1 keeps a zone's root key and tuning in plain chars,
unsigned on aarch64, so a negative fine tune played up to 2.5 semitones
sharp there, and a zone without a root key (its default, -1, read as 255)
read past a 128-entry table: NaN, or an endless loop that froze the
synthesis (found 2026-10-11; fixed upstream in Csound commit ceaad747,
not in any 6.x release).

The .sf2 files are not in git: they are built here and copied to the Pi by
tools/deploy.
"""

import math

import shutil
import struct
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(HERE))
from ambient.samples import FONTS, SAMPLES  # noqa: E402

FLUID = Path(sys.argv[1] if len(sys.argv) > 1 else "/usr/share/sounds/sf2/FluidR3_GM.sf2")
DOBRO = Path(sys.argv[2] if len(sys.argv) > 2 else
             Path.home() / "play/dobro-transcription/dobro-soundfont/build/BeardDobroPrototype.sf2")
OUT = HERE / "sounds"

# record layouts in the pdta chunk (SoundFont 2.04, section 7)
REC = {"phdr": "<20sHHHIII", "pbag": "<HH", "pmod": "<HHhHH", "pgen": "<HH", "inst": "<20sH",
       "ibag": "<HH", "imod": "<HHhHH", "igen": "<HH", "shdr": "<20sIIIIIBbHH"}
INSTRUMENT, SAMPLE_ID = 41, 53  # the generators that point to an instrument, a sample
ROOT_KEY, COARSE, FINE, SCALE_TUNING = 58, 51, 52, 56


def chunks(data: bytes, start: int, end: int):
    """(id, payload start, payload end) for the RIFF chunks between start and end."""
    i = start
    while i < end:
        cid, size = data[i:i + 4].decode("latin-1"), struct.unpack("<I", data[i + 4:i + 8])[0]
        yield cid, i + 8, i + 8 + size
        i += 8 + size + (size & 1)


def read(path: Path):
    data = path.read_bytes()
    assert data[:4] == b"RIFF" and data[8:12] == b"sfbk", f"{path} is not a SoundFont"
    lists, pdta = {}, {}
    for cid, a, b in chunks(data, 12, len(data)):
        if cid == "LIST":
            lists[data[a:a + 4].decode()] = (a + 4, b)
    for cid, a, b in chunks(data, *lists["sdta"]):
        if cid == "smpl":
            smpl = data[a:b]
    for cid, a, b in chunks(data, *lists["pdta"]):
        size = struct.calcsize(REC[cid])
        pdta[cid] = [struct.unpack(REC[cid], data[j:j + size]) for j in range(a, b, size)]
    return smpl, pdta


def subset(smpl: bytes, p: dict, wanted: list[tuple[int, int]]):
    """The SoundFont with only these (bank, program) presets: their
    instruments and samples, re-indexed; each sample followed by 46 zero
    points, as the format asks."""
    out = {k: [] for k in REC}
    inst_map, sample_map, data = {}, {}, bytearray()

    def add_sample(s):
        if s in sample_map:
            return sample_map[s]
        name, start, end, ls, le, rate, pitch, corr, link, typ = p["shdr"][s]
        sample_map[s] = len(out["shdr"])
        out["shdr"].append(None)  # placed now, filled in below (a linked pair refers to each other)
        at = len(data) // 2
        data.extend(smpl[start * 2:end * 2])
        data.extend(b"\0" * 92)
        new_link = add_sample(link) if typ in (2, 4, 8) and link < len(p["shdr"]) - 1 else 0
        out["shdr"][sample_map[s]] = (name, at, at + end - start, at + ls - start, at + le - start, rate, pitch,
                                      corr, new_link, typ)
        return sample_map[s]

    def add_instrument(i):
        if i in inst_map:
            return inst_map[i]
        inst_map[i] = len(out["inst"])
        out["inst"].append((p["inst"][i][0], len(out["ibag"])))
        for b in range(p["inst"][i][1], p["inst"][i + 1][1]):
            out["ibag"].append((len(out["igen"]), len(out["imod"])))
            out["imod"].extend(p["imod"][p["ibag"][b][1]:p["ibag"][b + 1][1]])
            for oper, amount in p["igen"][p["ibag"][b][0]:p["ibag"][b + 1][0]]:
                out["igen"].append((oper, add_sample(amount) if oper == SAMPLE_ID else amount))
        return inst_map[i]

    for bank, program in wanted:
        k = next(k for k, h in enumerate(p["phdr"][:-1]) if (h[2], h[1]) == (bank, program))
        name, prog, bnk, bag, lib, genre, morph = p["phdr"][k]
        out["phdr"].append((name, prog, bnk, len(out["pbag"]), lib, genre, morph))
        for b in range(bag, p["phdr"][k + 1][3]):
            out["pbag"].append((len(out["pgen"]), len(out["pmod"])))
            out["pmod"].extend(p["pmod"][p["pbag"][b][1]:p["pbag"][b + 1][1]])
            for oper, amount in p["pgen"][p["pbag"][b][0]:p["pbag"][b + 1][0]]:
                out["pgen"].append((oper, add_instrument(amount) if oper == INSTRUMENT else amount))
    # the terminal records
    out["phdr"].append((b"EOP", 0, 0, len(out["pbag"]), 0, 0, 0))
    out["pbag"].append((len(out["pgen"]), len(out["pmod"])))
    out["pmod"].append((0, 0, 0, 0, 0))
    out["pgen"].append((0, 0))
    out["inst"].append((b"EOI", len(out["ibag"])))
    out["ibag"].append((len(out["igen"]), len(out["imod"])))
    out["imod"].append((0, 0, 0, 0, 0))
    out["igen"].append((0, 0))
    out["shdr"].append((b"EOS", 0, 0, 0, 0, 0, 0, 0, 0, 0))
    return bytes(data), out


def chunk(cid: str, payload: bytes) -> bytes:
    return cid.encode() + struct.pack("<I", len(payload)) + payload + (b"\0" if len(payload) & 1 else b"")


def lst(kind: str, payload: bytes) -> bytes:
    return chunk("LIST", kind.encode() + payload)


def pdta(p: dict) -> bytes:
    """The preset data, as a LIST chunk."""
    return lst("pdta", b"".join(chunk(k, b"".join(struct.pack(REC[k], *r) for r in p[k])) for k in REC))


def write(path: Path, smpl: bytes, p: dict, name: str) -> None:
    """The FluidR3 subset, as a SoundFont."""
    info = lst("INFO", chunk("ifil", struct.pack("<HH", 2, 1)) + chunk("isng", b"EMU8000\0") +
               chunk("INAM", name.encode() + b"\0") +
               chunk("ICMT", b"Presets copied out of FluidR3_GM (Frank Wen; MIT licence) for ambient-room.\0"))
    body = b"sfbk" + info + lst("sdta", chunk("smpl", smpl)) + pdta(p)
    path.write_bytes(b"RIFF" + struct.pack("<I", len(body)) + body)


def normalise(path: Path) -> dict:
    """Rewrite a SoundFont in place so it sounds the same in any player and
    the Pi's Csound reads it right: every instrument zone gets an explicit
    root key, and a zone's tuning (coarse x 100 + fine cents) is made
    non-negative by raising its root key a semitone per 100 cents. Only
    the preset data changes: the font's own info (its name, author,
    licence) and its samples stay as they were. After the background
    agent's sf2normalize.py, tested on the Pi 2026-10-11."""
    s16 = lambda v: v - 65536 if v >= 32768 else v
    _, p = read(path)
    for oper, amount in p["pgen"]:
        if oper in (COARSE, FINE) and s16(amount) < 0:
            raise SystemExit(f"{path}: negative preset-level tuning, which a root key cannot absorb")
    stats = {"root keys added": 0, "retuned": 0}
    igen, ibag, inst = p["igen"], p["ibag"], [list(i) for i in p["inst"]]
    out_igen, out_ibag = [], []
    for ii in range(len(inst) - 1):
        z0, z1 = inst[ii][1], inst[ii + 1][1]
        inst[ii][1] = len(out_ibag)
        glob = {}
        for zi in range(z0, z1):
            gens = [list(g) for g in igen[ibag[zi][0]:ibag[zi + 1][0]]]
            out_ibag.append((len(out_igen), ibag[zi][1]))
            if SAMPLE_ID not in [g[0] for g in gens]:  # a global zone: defaults for the others
                if zi == z0:
                    glob = {g[0]: g[1] for g in gens}
                out_igen.extend(tuple(g) for g in gens)
                continue
            d = {**glob, **{g[0]: g[1] for g in gens}}
            if d.get(SCALE_TUNING, 100) != 100:
                print(f"  warning: {path.name} instrument {ii}: scale tuning {d[SCALE_TUNING]}, not 100")
            root = s16(d[ROOT_KEY]) if ROOT_KEY in d else -1
            if not 0 <= root <= 127:
                root = p["shdr"][d[SAMPLE_ID]][6]  # the sample's own pitch
            cents = s16(d.get(COARSE, 0)) * 100 + s16(d.get(FINE, 0))
            shift = math.ceil(-cents / 100) if cents < 0 else 0
            stats["root keys added"] += ROOT_KEY not in [g[0] for g in gens]
            stats["retuned"] += bool(shift)
            root, cents = root + shift, cents + 100 * shift
            assert 0 <= root <= 127, (path, ii, zi, root)
            want = {ROOT_KEY: root, COARSE: cents // 100, FINE: cents % 100}
            keep = [tuple(g) for g in gens if g[0] not in want and g[0] != SAMPLE_ID]
            add = [(op, v & 0xFFFF) for op, v in want.items() if op == ROOT_KEY or v or op in glob]
            out_igen.extend(keep + add + [tuple(g) for g in gens if g[0] == SAMPLE_ID])
    out_ibag.append((len(out_igen), ibag[-1][1]))
    inst[-1][1] = len(out_ibag) - 1
    out_igen.append((0, 0))
    p["ibag"], p["igen"], p["inst"] = out_ibag, out_igen, [tuple(i) for i in inst]
    data = path.read_bytes()
    a, b = next((a - 8, b) for cid, a, b in chunks(data, 12, len(data))
                if cid == "LIST" and data[a:a + 4] == b"pdta")
    data = data[:a] + pdta(p) + data[b:]
    path.write_bytes(data[:4] + struct.pack("<I", len(data) - 8) + data[8:])
    return stats


def main() -> None:
    OUT.mkdir(exist_ok=True)
    wanted = sorted({(s.bank, s.program) for s in SAMPLES.values() if s.font == "acoustic"})
    smpl, pdta = read(FLUID)
    data, p = subset(smpl, pdta, wanted)
    write(OUT / FONTS["acoustic"], data, p, "ambient-room acoustic")
    print(f"{OUT / FONTS['acoustic']}: {len(wanted)} presets, {len(p['shdr']) - 1} samples, "
          f"{(OUT / FONTS['acoustic']).stat().st_size / 1e6:.1f} MB")
    shutil.copyfile(DOBRO, OUT / FONTS["dobro"])
    print(f"{OUT / FONTS['dobro']}: copied from {DOBRO}")
    for font in FONTS.values():
        print(f"{OUT / font}: normalised for the Pi's Csound: {normalise(OUT / font)}")


if __name__ == "__main__":
    main()
